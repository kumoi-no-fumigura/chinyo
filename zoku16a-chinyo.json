 "poems": [
  {
   "seq": "1",
   "text": "夕立の雲ふきはらふうら風にひくてすゝしきあまのたくなは",
   "kana": "",
   "speaker": "",
   "page": 178,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "里とをくむめの下風にほひきておらぬそてさえ花のかそする",
   "kana": "",
   "speaker": "",
   "page": 178,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "ゆふたちの晴行あとのにはたつみやとるほとなき月の影かな",
   "kana": "",
   "speaker": "",
   "page": 178,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "めくりあふひときかもとの契まて思へは花のしるへなりけり",
   "kana": "",
   "speaker": "",
   "page": 178,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "ゆふされは人もわたらぬまろき橋おのかひかりにゆく營かな",
   "kana": "",
   "speaker": "",
   "page": 178,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "やま櫻ちりしくみねを今そしるあらしに春のかへるみちとは",
   "kana": "",
   "speaker": "",
   "page": 178,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "思ひあえすいつより秋にならのはのこかけすゝしき杜の夕影",
   "kana": "",
   "speaker": "",
   "page": 178,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "散花のなかれていつるみなと川いつくか春のとまりなるらん",
   "kana": "",
   "speaker": "",
   "page": 178,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "いつもきく松のあらしのおともなをわきてかなしき秋の夕暮",
   "kana": "",
   "speaker": "",
   "page": 178,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "五月雨にみなかみしろく浪こえてさらす數そふぬのひきの瀧",
   "kana": "",
   "speaker": "",
   "page": 178,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "ひこほしはあふ夕くれの空はれて雲のはたてにものは思はし",
   "kana": "",
   "speaker": "",
   "page": 178,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "やとからん里はいつくにありま山いなのをたとるきりの夕暮",
   "kana": "",
   "speaker": "",
   "page": 178,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "あらためし心のすゑをしるへにて法のみちにはまよばさり梟",
   "kana": "",
   "speaker": "",
   "page": 178,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "こはき咲野中のいほの跡にきてすみけん人のこゝろをそしる",
   "kana": "",
   "speaker": "",
   "page": 178,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "露霜のおくてのいなはかりにたに山たのなるこ音つれもなし",
   "kana": "",
   "speaker": "",
   "page": 178,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "あつまちや都もとなくなるさはの富士のかはせに千島鳴なり",
   "kana": "",
   "speaker": "",
   "page": 178,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "よゝをへてほしの光をあふけとも心のやみをなをそてらさぬ",
   "kana": "",
   "speaker": "",
   "page": 178,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "朝な〓〓このはちるらし神無月もりのあらしの聲そすくなき",
   "kana": "",
   "speaker": "",
   "page": 178,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "つらゝゐるほそたにかはの音たへてみ雪ふるらしきひの中山",
   "kana": "",
   "speaker": "",
   "page": 178,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "いぬかみやとこの山風さえ〓〓ていさやかはせの水こほるえ",
   "kana": "",
   "speaker": "",
   "page": 178,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "冬こもるみやまのさとの夕烟たつるもなをそさひしかりける",
   "kana": "",
   "speaker": "高棟王",
   "page": 178,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "ゆきかとやうちはらふ覽あし鴨のうはけもしろくやとる月影",
   "kana": "",
   "speaker": "貞村",
   "page": 178,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "今日もまたさやの中山越わひぬよこほりかけて雪はふりつ",
   "kana": "",
   "speaker": "〓成",
   "page": 178,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "しのふ山かよはゝ道もありぬへしさても心のおくそしちれぬ",
   "kana": "",
   "speaker": "珍也",
   "page": 178,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "いたつらにゆきて歸らん道もうししはしまとろめよひの關守",
   "kana": "",
   "speaker": "",
   "page": 178,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  }
 ],
